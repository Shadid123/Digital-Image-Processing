        "\n",
        "import cv2  # Used for image processing and resizing\n",
        "import os  # Used to create the output folder and manage file paths\n",
        "import matplotlib.pyplot as plt  # Used to display images and results\n",
        "\n",
        "# Read the input image\n",
        "image = cv2.imread(\"/content/input.jpg\")\n",
        "\n",
        "# Check whether the image was loaded successfully\n",
        "if image is None:\n",
        "    raise ValueError(\"Image not found. Check the filename.\")\n",
        "\n",
        "# Convert BGR to RGB for correct display in Matplotlib\n",
        "image = cv2.cvtColor(image, cv2.COLOR_BGR2RGB)\n",
        "\n",
        "# Get the original image height and width\n",
        "height, width = image.shape[:2]\n",
        "\n",
        "# Define the new dimensions by doubling the original size\n",
        "new_width = width * 2\n",
        "new_height = height * 2\n",
        "\n",
        "# Resize the image using Nearest Neighbor interpolation\n",
        "nearest = cv2.resize(\n",
        "    image, (new_width, new_height),\n",
        "    interpolation=cv2.INTER_NEAREST\n",
        ")\n",
        "\n",
        "# Resize the image using Bilinear interpolation\n",
        "bilinear = cv2.resize(\n",
        "    image, (new_width, new_height),\n",
        "    interpolation=cv2.INTER_LINEAR\n",
        ")\n",
        "\n",
        "# Resize the image using Bicubic interpolation\n",
        "bicubic = cv2.resize(\n",
        "    image, (new_width, new_height),\n",
        "    interpolation=cv2.INTER_CUBIC\n",
        ")\n",
        "\n",
        "# Create the output folder if it does not exist\n",
        "os.makedirs(\"/content/output\", exist_ok=True)\n",
        "\n",
        "# Save the resized images after converting RGB back to BGR\n",
        "cv2.imwrite(\"/content/output/nearest_neighbor.jpg\",\n",
        "            cv2.cvtColor(nearest, cv2.COLOR_RGB2BGR))\n",
        "\n",
        "cv2.imwrite(\"/content/output/bilinear.jpg\",\n",
        "            cv2.cvtColor(bilinear, cv2.COLOR_RGB2BGR))\n",
        "\n",
        "cv2.imwrite(\"/content/output/bicubic.jpg\",\n",
        "            cv2.cvtColor(bicubic, cv2.COLOR_RGB2BGR))\n",
        "\n",
        "# Display the original and interpolated images\n",
        "plt.figure(figsize=(12, 8))\n",
        "\n",
        "plt.subplot(2, 2, 1)\n",
        "plt.imshow(image)\n",
        "plt.title(\"Original Image\")\n",
        "plt.axis(\"off\")\n",
        "\n",
        "plt.subplot(2, 2, 2)\n",
        "plt.imshow(nearest)\n",
        "plt.title(\"Nearest Neighbor\")\n",
        "plt.axis(\"off\")\n",
        "\n",
        "plt.subplot(2, 2, 3)\n",
        "plt.imshow(bilinear)\n",
        "plt.title(\"Bilinear Interpolation\")\n",
        "plt.axis(\"off\")\n",
        "\n",
        "plt.subplot(2, 2, 4)\n",
        "plt.imshow(bicubic)\n",
        "plt.title(\"Bicubic Interpolation\")\n",
        "plt.axis(\"off\")\n",
        "\n",
        "# Adjust spacing and display the results\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "print(\"Spatial interpolation completed.\")\n",
        "print(\"Images saved in the output folder.\")\n"
      ]
